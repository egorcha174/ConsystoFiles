<!--  Consysto fork: macOS-like colors and selection, merged last in App.xaml so it overrides the defaults.  -->
<!--  High contrast is left to the system on purpose: only Light and Dark are redefined.  -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--  A solid selected row is a colored pill of its own: the side indicator would only add noise.  -->
	<x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
	<CornerRadius x:Key="ListViewItemCornerRadius">5</CornerRadius>
	<Thickness x:Key="GridViewItemSelectedBorderThickness">0</Thickness>

	<!--  Safari-like tabs share the whole strip. TabView reads these from application resources only, so they cannot live in TabBar.xaml.  -->
	<x:Double x:Key="TabViewItemMaxWidth">100000</x:Double>
	<x:Double x:Key="TabViewItemMinWidth">110</x:Double>

	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<!--  Accent  -->
			<Color x:Key="SystemAccentColor">#FF007AFF</Color>
			<Color x:Key="SystemAccentColorLight1">#FF3395FF</Color>
			<Color x:Key="SystemAccentColorLight2">#FF66AFFF</Color>
			<Color x:Key="SystemAccentColorLight3">#FF99CAFF</Color>
			<Color x:Key="SystemAccentColorDark1">#FF0062CC</Color>
			<Color x:Key="SystemAccentColorDark2">#FF004A99</Color>
			<Color x:Key="SystemAccentColorDark3">#FF003166</Color>
			<SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF007AFF" />
			<SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6007AFF" />
			<SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC007AFF" />
			<SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#FF007AFF" />
			<SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF0062CC" />
			<SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF0062CC" />
			<SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF007AFF" />
			<Color x:Key="App.Theme.FillColorAttention">#FF007AFF</Color>
			<SolidColorBrush x:Key="App.Theme.FillColorAttentionBrush" Color="#FF007AFF" />

			<!--  Sidebar and the unified toolbar row let the window backdrop through; the file area is a plain white sheet  -->
			<SolidColorBrush x:Key="App.Theme.Sidebar.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="App.Theme.AddressBar.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="App.Theme.Toolbar.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="App.Theme.FileArea.BackgroundBrush" Color="#FFFFFFFF" />

			<!--  Rows (details, list, columns): solid accent with white text, faint hover  -->
			<SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0A000000" />
			<SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#14000000" />
			<SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FF007AFF" />
			<SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FF1A88FF" />
			<SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FF006AE0" />
			<SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFFFF" />
			<SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#FFFFFFFF" />
			<SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="#FFFFFFFF" />

			<!--  Tiles (icons, cards): a soft rounded plate behind the item instead of a border  -->
			<SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="#0A000000" />
			<SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="#14000000" />
			<SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#29007AFF" />
			<SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#33007AFF" />
			<SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#40007AFF" />
		</ResourceDictionary>

		<ResourceDictionary x:Key="Dark">
			<!--  Accent  -->
			<Color x:Key="SystemAccentColor">#FF0A84FF</Color>
			<Color x:Key="SystemAccentColorLight1">#FF3B9CFF</Color>
			<Color x:Key="SystemAccentColorLight2">#FF6CB5FF</Color>
			<Color x:Key="SystemAccentColorLight3">#FF9DCEFF</Color>
			<Color x:Key="SystemAccentColorDark1">#FF086ACC</Color>
			<Color x:Key="SystemAccentColorDark2">#FF064F99</Color>
			<Color x:Key="SystemAccentColorDark3">#FF043566</Color>
			<SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF0A84FF" />
			<SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E60A84FF" />
			<SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC0A84FF" />
			<SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#FF0A84FF" />
			<SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF409CFF" />
			<SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF409CFF" />
			<SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF0A84FF" />
			<Color x:Key="App.Theme.FillColorAttention">#FF409CFF</Color>
			<SolidColorBrush x:Key="App.Theme.FillColorAttentionBrush" Color="#FF409CFF" />

			<!--  Sidebar and toolbar row  -->
			<SolidColorBrush x:Key="App.Theme.Sidebar.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="App.Theme.AddressBar.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="App.Theme.Toolbar.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="App.Theme.FileArea.BackgroundBrush" Color="#FF1E1E1E" />

			<!--  Rows  -->
			<SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0FFFFFFF" />
			<SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#1AFFFFFF" />
			<SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FF0A6CD6" />
			<SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FF1A78E0" />
			<SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FF085FBF" />
			<SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFFFF" />
			<SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#FFFFFFFF" />
			<SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="#FFFFFFFF" />

			<!--  Tiles  -->
			<SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="#0FFFFFFF" />
			<SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="#1AFFFFFF" />
			<SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="#3D0A84FF" />
			<SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="#4D0A84FF" />
			<SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="#5C0A84FF" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
