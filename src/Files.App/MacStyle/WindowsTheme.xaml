<!--  Consysto fork: merged instead of MacTheme.xaml when the Windows 11 look is chosen. App resources win over Generic.xaml,
	so this brings back the stock sidebar selection card that SidebarStyles.xaml replaced with the macOS pill.  -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<!--  The toolbar row sits on the window backdrop, next to the caption buttons, without cards behind its halves  -->
			<SolidColorBrush x:Key="App.Theme.AddressBar.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="App.Theme.Toolbar.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="SidebarItemBackgroundSelected" Color="#B3FFFFFF" />
			<SolidColorBrush x:Key="SidebarItemBackgroundSelectedPointerOver" Color="#80F9F9F9" />
			<SolidColorBrush x:Key="SidebarItemBackgroundSelectedPressed" Color="#4DF9F9F9" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Dark">
			<!--  The toolbar row sits on the window backdrop, next to the caption buttons, without cards behind its halves  -->
			<SolidColorBrush x:Key="App.Theme.AddressBar.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="App.Theme.Toolbar.BackgroundBrush" Color="Transparent" />
			<SolidColorBrush x:Key="SidebarItemBackgroundSelected" Color="#0FFFFFFF" />
			<SolidColorBrush x:Key="SidebarItemBackgroundSelectedPointerOver" Color="#15FFFFFF" />
			<SolidColorBrush x:Key="SidebarItemBackgroundSelectedPressed" Color="#08FFFFFF" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="HighContrast">
			<SolidColorBrush x:Key="SidebarItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
			<SolidColorBrush x:Key="SidebarItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
			<SolidColorBrush x:Key="SidebarItemBackgroundSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
