<!--  Consysto fork: comparison of the folders open in both panes, with a copy direction per item.  -->
<ContentDialog
	x:Class="Files.App.MacStyle.CompareFoldersDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:macstyle="using:Files.App.MacStyle"
	x:Name="RootDialog"
	Title="{helpers:ResourceString Name=ConsystoCompareFolders}"
	CloseButtonText="{helpers:ResourceString Name=Cancel}"
	CornerRadius="{StaticResource OverlayCornerRadius}"
	DefaultButton="Primary"
	IsPrimaryButtonEnabled="False"
	Style="{StaticResource DefaultContentDialogStyle}">

	<ContentDialog.Resources>
		<x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
		<x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
	</ContentDialog.Resources>

	<Grid Width="1040" RowSpacing="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="460" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Options  -->
		<StackPanel
			Grid.Row="0"
			Orientation="Horizontal"
			Spacing="16">
			<CheckBox
				x:Name="SubfoldersCheckBox"
				Click="Subfolders_Click"
				Content="{helpers:ResourceString Name=ConsystoCompareSubfolders}"
				IsChecked="True" />
			<CheckBox
				x:Name="ShowIdenticalCheckBox"
				Click="ShowIdentical_Click"
				Content="{helpers:ResourceString Name=ConsystoCompareShowIdentical}" />
			<ProgressRing
				x:Name="ScanProgress"
				Width="16"
				Height="16"
				VerticalAlignment="Center"
				IsActive="False"
				Visibility="Collapsed" />
			<TextBlock
				x:Name="StatusText"
				VerticalAlignment="Center"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
		</StackPanel>

		<!--  Column headers: the two folders over their size and date columns  -->
		<Grid
			Grid.Row="1"
			Padding="16,0,16,0"
			ColumnSpacing="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="90" />
				<ColumnDefinition Width="140" />
				<ColumnDefinition Width="44" />
				<ColumnDefinition Width="140" />
				<ColumnDefinition Width="90" />
			</Grid.ColumnDefinitions>
			<TextBlock
				Grid.Column="0"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{helpers:ResourceString Name=ConsystoCompareName}" />
			<TextBlock
				x:Name="LeftPathText"
				Grid.Column="1"
				Grid.ColumnSpan="2"
				HorizontalAlignment="Right"
				FontWeight="SemiBold"
				TextTrimming="CharacterEllipsis" />
			<TextBlock
				x:Name="RightPathText"
				Grid.Column="4"
				Grid.ColumnSpan="2"
				FontWeight="SemiBold"
				TextTrimming="CharacterEllipsis" />
		</Grid>

		<ListView
			x:Name="EntriesList"
			Grid.Row="2"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="4"
			ItemsSource="{x:Bind Entries}"
			SelectionMode="None">
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="macstyle:FolderCompareEntry">
					<Grid Height="32" ColumnSpacing="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="90" />
							<ColumnDefinition Width="140" />
							<ColumnDefinition Width="44" />
							<ColumnDefinition Width="140" />
							<ColumnDefinition Width="90" />
						</Grid.ColumnDefinitions>

						<StackPanel
							Grid.Column="0"
							VerticalAlignment="Center"
							Opacity="{x:Bind RowOpacity}"
							Orientation="Horizontal"
							Spacing="8">
							<FontIcon FontSize="14" Glyph="{x:Bind TypeGlyph}" />
							<TextBlock Text="{x:Bind RelativePath}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind RelativePath}" />
						</StackPanel>

						<TextBlock
							Grid.Column="1"
							HorizontalAlignment="Right"
							VerticalAlignment="Center"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="{x:Bind LeftSizeText}" />
						<TextBlock
							Grid.Column="2"
							HorizontalAlignment="Right"
							VerticalAlignment="Center"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="{x:Bind LeftDateText}" />

						<Button
							Grid.Column="3"
							MinWidth="0"
							Padding="0"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							Background="Transparent"
							BorderThickness="0"
							Click="ActionButton_Click"
							IsEnabled="{x:Bind CanChangeAction}">
							<TextBlock
								FontSize="18"
								Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
								Text="{x:Bind ActionText, Mode=OneWay}" />
						</Button>

						<TextBlock
							Grid.Column="4"
							VerticalAlignment="Center"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="{x:Bind RightDateText}" />
						<TextBlock
							Grid.Column="5"
							VerticalAlignment="Center"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="{x:Bind RightSizeText}" />
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>

		<Grid Grid.Row="3" ColumnSpacing="16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="SummaryText" TextTrimming="CharacterEllipsis" />
			<TextBlock
				Grid.Column="1"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{helpers:ResourceString Name=ConsystoCompareActionHint}" />
		</Grid>
	</Grid>
</ContentDialog>
