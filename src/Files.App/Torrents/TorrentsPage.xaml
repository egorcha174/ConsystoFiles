<!--  Consysto fork: torrent downloads laid out like qBittorrent — a command bar, a table of downloads, details below.  -->
<Page
	x:Class="Files.App.Torrents.TorrentsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.App.Controls"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:torrents="using:Files.App.Torrents">

	<Page.Resources>
		<Style x:Key="TorrentHeaderButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="8,4" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
		</Style>
		<Style x:Key="TorrentCellStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			<Setter Property="Padding" Value="8,0" />
		</Style>
		<Style
			x:Key="TorrentNumberCellStyle"
			BasedOn="{StaticResource TorrentCellStyle}"
			TargetType="TextBlock">
			<Setter Property="TextAlignment" Value="Right" />
		</Style>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" MinHeight="120" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="260" MinHeight="80" />
		</Grid.RowDefinitions>

		<!--  Command bar: add, start, pause, remove; tracker filter and search on the right  -->
		<Grid
			Padding="12,8"
			BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
			BorderThickness="0,0,0,1"
			ColumnSpacing="4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Orientation="Horizontal" Spacing="2">
				<Button x:Name="AddMagnetButton" ToolTipService.ToolTip="{helpers:ResourceString Name=ConsystoTorrentAddMagnet}">
					<FontIcon FontSize="16" Glyph="&#xE71B;" />
					<Button.Flyout>
						<Flyout x:Name="MagnetFlyout" Placement="BottomEdgeAlignedLeft">
							<StackPanel Width="460" Spacing="8">
								<TextBox
									x:Name="MagnetBox"
									KeyDown="MagnetBox_KeyDown"
									PlaceholderText="{helpers:ResourceString Name=ConsystoTorrentMagnetPlaceholder}" />
								<Button
									HorizontalAlignment="Right"
									Click="AddMagnet_Click"
									Content="{helpers:ResourceString Name=ConsystoTorrentAddMagnet}"
									Style="{StaticResource AccentButtonStyle}" />
							</StackPanel>
						</Flyout>
					</Button.Flyout>
				</Button>
				<Button Click="AddFile_Click" ToolTipService.ToolTip="{helpers:ResourceString Name=ConsystoTorrentAddFile}">
					<FontIcon FontSize="16" Glyph="&#xE710;" />
				</Button>
				<AppBarSeparator />
				<Button
					x:Name="ResumeButton"
					Click="Resume_Click"
					ToolTipService.ToolTip="{helpers:ResourceString Name=ConsystoTorrentResume}">
					<FontIcon
						FontSize="16"
						Foreground="{ThemeResource SystemFillColorSuccessBrush}"
						Glyph="&#xE768;" />
				</Button>
				<Button
					x:Name="PauseButton"
					Click="Pause_Click"
					ToolTipService.ToolTip="{helpers:ResourceString Name=ConsystoTorrentPause}">
					<FontIcon
						FontSize="16"
						Foreground="{ThemeResource SystemFillColorCautionBrush}"
						Glyph="&#xE769;" />
				</Button>
				<Button
					x:Name="RemoveButton"
					Click="Remove_Click"
					ToolTipService.ToolTip="{helpers:ResourceString Name=ConsystoTorrentRemove}">
					<FontIcon
						FontSize="16"
						Foreground="{ThemeResource SystemFillColorCriticalBrush}"
						Glyph="&#xE74D;" />
				</Button>
				<AppBarSeparator />
				<Button
					x:Name="OpenFolderButton"
					Click="OpenFolder_Click"
					ToolTipService.ToolTip="{helpers:ResourceString Name=ConsystoTorrentOpenFolder}">
					<FontIcon FontSize="16" Glyph="&#xE838;" />
				</Button>
			</StackPanel>

			<ComboBox
				x:Name="TrackerFilter"
				Grid.Column="2"
				MinWidth="180"
				SelectionChanged="Filter_Changed" />
			<AutoSuggestBox
				x:Name="SearchBox"
				Grid.Column="3"
				Width="240"
				PlaceholderText="{helpers:ResourceString Name=ConsystoTorrentSearch}"
				QueryIcon="Find"
				TextChanged="SearchBox_TextChanged" />
		</Grid>

		<!--  The table of downloads  -->
		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<Grid
				x:Name="HeaderRow"
				Padding="12,0"
				BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
				BorderThickness="0,0,0,1" />

			<ListView
				x:Name="TorrentList"
				Grid.Row="1"
				Padding="12,0"
				DoubleTapped="TorrentList_DoubleTapped"
				SelectionChanged="TorrentList_SelectionChanged"
				SelectionMode="Single">
				<ListView.ItemContainerStyle>
					<Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						<Setter Property="Padding" Value="0" />
						<Setter Property="MinHeight" Value="30" />
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="torrents:TorrentRow">
						<Grid Height="30" Loaded="Row_Loaded">
							<TextBlock
								Style="{StaticResource TorrentCellStyle}"
								Text="{x:Bind Name, Mode=OneWay}"
								ToolTipService.ToolTip="{x:Bind SavePath, Mode=OneWay}" />
							<TextBlock
								Grid.Column="1"
								Style="{StaticResource TorrentNumberCellStyle}"
								Text="{x:Bind SizeText, Mode=OneWay}" />
							<Grid Grid.Column="2" Margin="8,5">
								<ProgressBar
									Height="18"
									MinHeight="18"
									CornerRadius="3"
									Maximum="1"
									ShowError="{x:Bind IsError, Mode=OneWay}"
									ShowPaused="{x:Bind IsPaused, Mode=OneWay}"
									Value="{x:Bind Progress, Mode=OneWay}" />
								<TextBlock
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									FontSize="11"
									Text="{x:Bind ProgressText, Mode=OneWay}" />
							</Grid>
							<TextBlock
								Grid.Column="3"
								Foreground="{x:Bind StateBrush, Mode=OneWay}"
								Style="{StaticResource TorrentCellStyle}"
								Text="{x:Bind StateText, Mode=OneWay}" />
							<TextBlock
								Grid.Column="4"
								Style="{StaticResource TorrentNumberCellStyle}"
								Text="{x:Bind Seeds, Mode=OneWay}" />
							<TextBlock
								Grid.Column="5"
								Style="{StaticResource TorrentNumberCellStyle}"
								Text="{x:Bind Leechers, Mode=OneWay}" />
							<TextBlock
								Grid.Column="6"
								Style="{StaticResource TorrentNumberCellStyle}"
								Text="{x:Bind DownloadRateText, Mode=OneWay}" />
							<TextBlock
								Grid.Column="7"
								Style="{StaticResource TorrentNumberCellStyle}"
								Text="{x:Bind UploadRateText, Mode=OneWay}" />
							<TextBlock
								Grid.Column="8"
								Style="{StaticResource TorrentNumberCellStyle}"
								Text="{x:Bind RemainingText, Mode=OneWay}" />
							<TextBlock
								Grid.Column="9"
								Style="{StaticResource TorrentNumberCellStyle}"
								Text="{x:Bind RatioText, Mode=OneWay}" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<TextBlock
				x:Name="EmptyText"
				Grid.Row="1"
				MaxWidth="560"
				Margin="24"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{helpers:ResourceString Name=ConsystoTorrentsEmpty}"
				TextAlignment="Center"
				TextWrapping="Wrap" />
		</Grid>

		<controls:GridSplitter
			Grid.Row="2"
			Height="6"
			HorizontalAlignment="Stretch"
			Background="Transparent"
			ResizeBehavior="PreviousAndNext"
			ResizeDirection="Rows" />

		<!--  Details of the selected download  -->
		<Grid
			Grid.Row="3"
			BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
			BorderThickness="0,1,0,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<SelectorBar x:Name="DetailsTabs" SelectionChanged="DetailsTabs_SelectionChanged">
				<SelectorBarItem
					x:Name="FilesTab"
					IsSelected="True"
					Text="{helpers:ResourceString Name=ConsystoTorrentFiles}" />
				<SelectorBarItem x:Name="PeersTab" Text="{helpers:ResourceString Name=ConsystoTorrentPeersTab}" />
				<SelectorBarItem x:Name="TrackersTab" Text="{helpers:ResourceString Name=ConsystoTorrentTrackers}" />
			</SelectorBar>

			<ListView
				x:Name="FileList"
				Grid.Row="1"
				Padding="12,0"
				SelectionMode="None">
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="torrents:TorrentFileRow">
						<Grid Height="28" ColumnSpacing="8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="32" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="140" />
							</Grid.ColumnDefinitions>
							<CheckBox
								MinWidth="0"
								Click="FileWanted_Click"
								IsChecked="{x:Bind IsWanted, Mode=OneWay}"
								Tag="{x:Bind Index}"
								ToolTipService.ToolTip="{helpers:ResourceString Name=ConsystoTorrentFileWanted}" />
							<TextBlock
								Grid.Column="1"
								Style="{StaticResource TorrentCellStyle}"
								Text="{x:Bind Path}" />
							<TextBlock
								Grid.Column="2"
								Style="{StaticResource TorrentNumberCellStyle}"
								Text="{x:Bind SizeText}" />
							<ProgressBar
								Grid.Column="3"
								VerticalAlignment="Center"
								Maximum="1"
								Value="{x:Bind Progress}" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<ListView
				x:Name="PeerList"
				Grid.Row="1"
				Padding="12,0"
				SelectionMode="None"
				Visibility="Collapsed">
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="torrents:TorrentPeerRow">
						<Grid Height="28" ColumnSpacing="8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="220" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="80" />
								<ColumnDefinition Width="100" />
								<ColumnDefinition Width="100" />
							</Grid.ColumnDefinitions>
							<TextBlock Style="{StaticResource TorrentCellStyle}" Text="{x:Bind Address}" />
							<TextBlock
								Grid.Column="1"
								Style="{StaticResource TorrentCellStyle}"
								Text="{x:Bind Client}" />
							<TextBlock
								Grid.Column="2"
								Style="{StaticResource TorrentNumberCellStyle}"
								Text="{x:Bind ProgressText}" />
							<TextBlock
								Grid.Column="3"
								Style="{StaticResource TorrentNumberCellStyle}"
								Text="{x:Bind DownloadRateText}" />
							<TextBlock
								Grid.Column="4"
								Style="{StaticResource TorrentNumberCellStyle}"
								Text="{x:Bind UploadRateText}" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<ListView
				x:Name="TrackerList"
				Grid.Row="1"
				Padding="12,0"
				SelectionMode="None"
				Visibility="Collapsed">
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="torrents:TorrentTrackerRow">
						<Grid Height="28" ColumnSpacing="8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="140" />
								<ColumnDefinition Width="2*" />
							</Grid.ColumnDefinitions>
							<TextBlock Style="{StaticResource TorrentCellStyle}" Text="{x:Bind Address}" />
							<TextBlock
								Grid.Column="1"
								Style="{StaticResource TorrentCellStyle}"
								Text="{x:Bind Status}" />
							<TextBlock
								Grid.Column="2"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Style="{StaticResource TorrentCellStyle}"
								Text="{x:Bind Message}" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<TextBlock
				x:Name="DetailsEmptyText"
				Grid.Row="1"
				Margin="24"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{helpers:ResourceString Name=ConsystoTorrentSelectHint}" />
		</Grid>
	</Grid>
</Page>
