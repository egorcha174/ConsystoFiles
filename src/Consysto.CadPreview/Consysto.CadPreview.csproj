<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Consysto.CadPreview</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" />
    <PackageReference Include="OpenMcdf" />
  </ItemGroup>

  <ItemGroup>
    <!-- The drawings kind of the catalogue engine, like books in book-preview -->
    <ProjectReference Include="..\Consysto.Collections\Consysto.Collections.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keeps ACadSharp's reflection-mapped members under trimming / Native AOT, see the file. -->
    <EmbeddedResource Include="ILLink.Descriptors.xml" LogicalName="ILLink.Descriptors.xml" />
  </ItemGroup>

</Project>
